{
  "extends": "./tsconfig.performance.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2020",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@app/*": [
        "./src/*"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@private/*": [
        "./src/private/app/*"
      ],
      "@plugins-external/*": [
        "./src/plugins-external/*"
      ],
    },
    "moduleResolution": "bundler",
    "strict": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // tsgo does not auto-include every package under node_modules/@types the way
    // tsc does, so the globals this app uses (process, NodeJS) must be declared.
    "types": [
      "node"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "scripts/plugin/**/*.ts",
    "test/equipment/antenna-ui-headless.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    // Plugin unit tests run through vitest.external.config.mts with vitest globals.
    "src/plugins-external/**/__tests__/**",
    "scripts/plugin/templates/**"
  ]
}