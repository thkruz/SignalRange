# Dependencies
node_modules/

# Build outputs
dist/
*.tsbuildinfo
.wrangler/

# IDEs and editors
.claude/
.github/instructions/

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Temporary files
tmp/
temp/
supabase/

# Notes
*.notes.*
.archive

# Unused Icons
src/assets/icons/wip

# Large audio assets (stored in R2, not in git)
# Campaign audio files can be large and numerous
public/assets/campaigns/**/*.mp3
public/assets/campaigns/**/*.wav
public/assets/campaigns/**/*.ogg
public/assets/campaigns/**/*.png
public/assets/campaigns/**/*.jpg
public/assets/characters/**/*.png
public/**/wip/

# Keep directory structure with .gitkeep files
!public/assets/campaigns/**/.gitkeep
!public/assets/campaigns/**/README.md
# Generated by scripts/vo-manifest.mjs
*-vo-manifest.json
*-vo-script-*.md

# External plugins: nested git clones restored from external-plugins.json via
# `pnpm run plugin -- restore`. The clones are never committed; the lockfile and
# the committed src/plugins/plugin-manifest.external.generated.ts capture the set.
/src/plugins-external/*
!/src/plugins-external/.gitkeep
!/src/plugins-external/README.md
