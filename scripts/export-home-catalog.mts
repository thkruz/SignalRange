/**
 * Export the public catalog the signalrange.space home site needs for its Achievements and
 * Progress pages: campaigns, missions, the NICE task codes each objective trains, the NICE task
 * descriptions, and the achievement rules from src/user-account/achievement-catalog.ts.
 *
 * The home site evaluates a signed-in player's saved scenario progress against this file, so it
 * must be regenerated whenever campaigns, objectives' `nice` arrays or the achievement catalog change.
 *
 * Run from the repo root:
 *   npx tsx scripts/export-home-catalog.mts [outFile]
 * Default outFile: ../signal-range-home/src/data/signalrange-catalog.json
 */
import { writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { register } from 'node:module';
import { JSDOM } from 'jsdom';

// Stub style and asset imports the bundler normally handles.
const assetStub = `export async function load(url, context, next) {
  if (/\\.(css|scss|png|jpe?g|webp|gif|svg|mp3|ogg|wav|woff2?|ttf|glb|html)(\\?.*)?$/u.test(url)) {
    return { format: 'module', source: 'export default ""', shortCircuit: true };
  }
  return next(url, context);
}`;
register(`data:text/javascript,${encodeURIComponent(assetStub)}`);
import type { ScenarioProgress } from '@app/user-account/types';
import niceDescriptions from '../src/presentation/nice-task-descriptions.json';

// Campaign modules pull in engine code that touches window/document at import time.
const dom = new JSDOM('<!doctype html><html><body></body></html>', { url: 'http://localhost/' });
for (const key of ['window', 'document', 'navigator', 'localStorage', 'HTMLElement', 'Element', 'Node', 'CustomEvent', 'Event', 'getComputedStyle', 'requestAnimationFrame', 'cancelAnimationFrame']) {
  if (!(key in globalThis)) Object.defineProperty(globalThis, key, { value: (dom.window as unknown as Record<string, unknown>)[key], configurable: true, writable: true });
}
globalThis.requestAnimationFrame ??= ((cb: FrameRequestCallback) => setTimeout(() => cb(Date.now()), 16) as unknown as number);

const { ccsCampaignData, geolocationCampaignData, hamSdrCampaignData, natsCampaignData } = await import('@app/campaigns/nats/campaign-data');
const { natsEuCampaignData } = await import('@app/campaigns/nats-eu/campaign-data');
const { getReleaseStage } = await import('@app/campaigns/release-stage');
const { achievementCatalog, campaignMissions } = await import('@app/user-account/achievement-catalog');

const repoRoot = join(dirname(fileURLToPath(import.meta.url)), '..');
const outFile = resolve(process.argv[2] ?? join(repoRoot, '..', 'signal-range-home', 'src', 'data', 'signalrange-catalog.json'));

// Same order the router registers them, so the catalog matches the in-app profile.
const campaigns = [natsCampaignData, natsEuCampaignData, hamSdrCampaignData, ccsCampaignData, geolocationCampaignData];

const isTask = (code: string): boolean => /^T\d{4}$/u.test(code);
const usedTasks = new Set<string>();

const campaignOut = campaigns.map((campaign) => ({
  id: campaign.id,
  title: campaign.title,
  releaseStage: getReleaseStage(campaign),
  missions: campaignMissions(campaign).map((mission) => {
    // Only required objectives count, matching the in-app campaign epilogue.
    const objectives = (mission.objectives ?? [])
      .filter((objective) => !objective.isOptional)
      .map((objective) => ({ id: objective.id, tasks: [...new Set((objective.nice ?? []).filter(isTask))].sort() }))
      .filter((objective) => objective.tasks.length > 0);
    objectives.forEach((objective) => objective.tasks.forEach((task) => usedTasks.add(task)));
    return { id: mission.id, number: mission.number, title: mission.title, objectives };
  }),
}));

// Achievement rules are closures in the app, so probe each one to recover its qualifying
// missions and whether it needs a penalty-free run.
const allMissionIds = campaignOut.flatMap((campaign) => campaign.missions.map((mission) => mission.id));
const probe = (scenarioId: string, penalty: number): ScenarioProgress =>
  ({ scenarioId, quizPenalties: penalty, timePenalties: penalty }) as ScenarioProgress;
const achievements = achievementCatalog(campaigns).map((definition) => {
  const missionIds = allMissionIds.filter((id) => definition.qualifies(probe(id, 0)));
  const requiresClean = missionIds.some((id) => !definition.qualifies(probe(id, 1)));
  return {
    id: definition.id,
    title: definition.title,
    description: definition.description,
    category: definition.category,
    target: definition.target,
    missionIds,
    requiresClean,
  };
});

const tasks = (niceDescriptions as { tasks: Record<string, string> }).tasks;
const payload = {
  _comment: 'Generated by signal-range/scripts/export-home-catalog.mts. Do not edit by hand; rerun the script after campaign, NICE or achievement changes.',
  generatedAt: new Date().toISOString(),
  campaigns: campaignOut,
  achievements,
  niceTasks: Object.fromEntries([...usedTasks].sort().map((code) => [code, tasks[code] ?? ''])),
};

writeFileSync(outFile, `${JSON.stringify(payload, null, 2)}\n`);
const missionCount = campaignOut.reduce((sum, campaign) => sum + campaign.missions.length, 0);
console.log(`Wrote ${outFile}: ${campaignOut.length} campaigns, ${missionCount} missions, ${achievements.length} achievements, ${usedTasks.size} NICE tasks.`);
